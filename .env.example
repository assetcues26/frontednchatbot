# The backend. No secret here -- the browser only ever calls this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (Project Settings -> API). The anon key is designed to be public;
# it is protected by Row Level Security and by the backend's own JWT checks.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put OPENAI_API_KEY or the Supabase service-role key in this file.
# Anything named NEXT_PUBLIC_* is shipped to the browser.
